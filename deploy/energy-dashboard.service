[Unit]
Description=Energie-Dashboard (Shelly Verbrauchstracking)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/energie-dashboard
ExecStart=/home/pi/energie-dashboard/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
